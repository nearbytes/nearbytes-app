# Copy to repo-root `.env.e2e` (gitignored) for live MEGA tests.
NEARBYTES_E2E_MEGA_OWNER_EMAIL=owner@example.com
# Same value as owner for `e2e/mega-owner-upstream.spec.ts` and `e2e/mega-browser-login.spec.ts`.
NEARBYTES_E2E_MEGA_EMAIL=owner@example.com
NEARBYTES_E2E_MEGA_RECIPIENT_EMAIL=recipient@example.com
NEARBYTES_E2E_MEGA_PASSWORD=replace-me
NEARBYTES_E2E_API=http://127.0.0.1:3000
