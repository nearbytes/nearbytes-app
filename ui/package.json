{
  "name": "nearbytes-ui",
  "version": "0.7.5",
  "type": "module",
  "packageManager": "yarn@4.10.3",
  "scripts": {
    "dev": "node ../scripts/run-web-dev.mjs",
    "dev:iphone": "node ../scripts/run-iphone-dev.mjs",
    "dev:raw": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "mobile:copy": "cap copy",
    "mobile:ios:add": "cap add ios",
    "mobile:ios:sync": "yarn build && cap sync ios",
    "mobile:ios:open": "cap open ios",
    "mobile:ios:build": "xcodebuild -project ios/App/App.xcodeproj -scheme App -configuration Debug -destination 'generic/platform=iOS Simulator' CODE_SIGNING_ALLOWED=NO build",
    "mobile:ios:build:device": "xcodebuild -project ios/App/App.xcodeproj -scheme App -configuration Debug -destination 'generic/platform=iOS' CODE_SIGNING_ALLOWED=NO build"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/preferences": "^8.0.1",
    "buffer": "^6.0.3",
    "idb": "^8.0.0",
    "lucide-svelte": "^0.577.0",
    "nearbytes-crypto": "nearbytes/nearbytes-crypto#main",
    "nearbytes-files": "nearbytes/nearbytes-files#main",
    "nearbytes-log": "nearbytes/nearbytes-log#main",
    "nearbytes-storage": "nearbytes/nearbytes-storage#main",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.0",
    "@capacitor/ios": "^8.3.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.2",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.0",
    "workbox-window": "^7.0.0"
  }
}
