{
  "name": "nearbytes-app",
  "version": "0.1.0",
  "description": "NearBytes desktop app — Electron + Svelte 5, Finder-like Files + Chat UI.",
  "type": "module",
  "main": "out/main/index.js",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "engines:check": "node scripts/ensure-engines.mjs --electron",
    "refresh": "node scripts/refresh.mjs",
    "dev": "node scripts/dev-bootstrap.mjs && node scripts/electron-vite-runner.mjs dev",
    "dev-local": "NEARBYTES_LOCAL_DEPS=1 node scripts/dev-bootstrap.mjs && node scripts/electron-vite-runner.mjs dev",
    "dev:fast": "node scripts/electron-vite-runner.mjs dev",
    "build": "node scripts/dev-bootstrap.mjs && electron-vite build",
    "build:fast": "electron-vite build",
    "preview": "node scripts/electron-vite-runner.mjs preview",
    "start": "node scripts/electron-vite-runner.mjs preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "svelte-check --tsconfig ./tsconfig.json",
    "package": "node scripts/dev-bootstrap.mjs && electron-vite build && electron-builder",
    "dev:servant": "node scripts/dev-servant.mjs",
    "test": "tsc src/renderer/lib/syncAnalysis.ts --outDir out-test --module esnext --target es2022 --moduleResolution bundler --skipLibCheck && node --test test/*.test.mjs"
  },
  "dependencies": {
    "nearbytes-chat": "github:nearbytes/nearbytes-chat",
    "nearbytes-crypto": "github:nearbytes/nearbytes-crypto",
    "nearbytes-engine": "github:nearbytes/nearbytes-engine",
    "nearbytes-files": "github:nearbytes/nearbytes-files",
    "nearbytes-log": "github:nearbytes/nearbytes-log",
    "nearbytes-skeleton": "github:nearbytes/nearbytes-skeleton",
    "nearbytes-sync": "github:nearbytes/nearbytes-sync"
  },
  "resolutions": {
    "nearbytes-widgets": "github:nearbytes/nearbytes-widgets"
  },
  "devDependencies": {
    "@lucide/svelte": "^0.482.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "electron": "^36.7.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^3.0.0",
    "nearbytes-components": "github:nearbytes/nearbytes-components",
    "nearbytes-widgets": "github:nearbytes/nearbytes-widgets",
    "svelte": "^5.20.0",
    "svelte-check": "^4.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "packageManager": "yarn@4.15.0",
  "dependenciesMeta": {
    "electron": {
      "built": true
    }
  }
}
